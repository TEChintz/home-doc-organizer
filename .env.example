# Copy to .env and fill in. Everything here is public-safe: Vite inlines any
# VITE_-prefixed variable into the browser bundle, so never put a secret here.

# Docket API. Defaults to the deployed instance when unset.
VITE_API_BASE_URL=https://docket-api-pi.vercel.app

# Supabase — used only for sign-in. The anon key is designed to be public: every
# table has row level security enabled with no policies, so it grants nothing on
# its own. The service-role key must NEVER appear in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shown on the WhatsApp linking screen. Optional.
VITE_WHATSAPP_NUMBER=+1 555 143 0916
